import { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import api from '../services/api';
import toast from 'react-hot-toast';

const AirportTransferRequest = () => {
  const navigate = useNavigate();
  const [loading, setLoading] = useState(false);

  const [formData, setFormData] = useState({
    action_type: 'quote',
    full_name: '',
    phone: '',
    email: '',
    flight_number: '',
    airline: '',
    arrival_time: '',
    departure_time: '',
    transfer_type: 'pickup', // pickup or dropoff
    pickup_location: '',
    dropoff_location: '',
    pickup_date: '',
    pickup_time: '',
    passengers: 1,
    luggage_count: 0,
    vehicle_type: '',
    special_requests: '',
    base_amount: 0,
    notes: ''
  });

  const handleSubmit = async (e) => {
    e.preventDefault();
    setLoading(true);

    const payload = {
      ...formData,
      email: formData.email || null,
      arrival_time: formData.arrival_time ? new Date(formData.arrival_time).toISOString() : null,
      departure_time: formData.departure_time ? new Date(formData.departure_time).toISOString() : null,
      pickup_date: new Date(formData.pickup_date).toISOString(),
      base_amount: parseFloat(formData.base_amount) || 0,
      notes: formData.notes || null,
    };

    try {
      const formDataObj = new FormData();
      formDataObj.append('data', JSON.stringify(payload));
      const res = await api.post('/api/airporttransfer/request', formDataObj, {
        headers: { 'Content-Type': 'multipart/form-data' }
      });
      toast.success('Airport transfer request submitted!');
      navigate('/dashboard');
    } catch (err) {
      toast.error('Failed to submit');
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="container mx-auto px-4 py-12 max-w-4xl">
      <div className="glass-card p-8">
        <h1 className="text-3xl font-black mb-6">Airport Transfer Request</h1>
        <form onSubmit={handleSubmit} className="space-y-8">
          <fieldset className="border rounded-lg p-4">
            <legend className="font-bold text-lg px-2">Personal Details</legend>
            <div className="grid md:grid-cols-2 gap-4 mt-2">
              <div><label className="block font-bold mb-1">Full Name *</label><input type="text" required className="w-full p-2 border rounded" value={formData.full_name} onChange={e => setFormData({...formData, full_name: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Phone *</label><input type="tel" required className="w-full p-2 border rounded" value={formData.phone} onChange={e => setFormData({...formData, phone: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Email *</label><input type="email" required className="w-full p-2 border rounded" value={formData.email} onChange={e => setFormData({...formData, email: e.target.value})} /></div>
            </div>
          </fieldset>

          <fieldset className="border rounded-lg p-4">
            <legend className="font-bold text-lg px-2">Flight Details</legend>
            <div className="grid md:grid-cols-2 gap-4 mt-2">
              <div><label className="block font-bold mb-1">Flight Number *</label><input type="text" required className="w-full p-2 border rounded" value={formData.flight_number} onChange={e => setFormData({...formData, flight_number: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Airline</label><input type="text" className="w-full p-2 border rounded" value={formData.airline} onChange={e => setFormData({...formData, airline: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Arrival Time</label><input type="datetime-local" className="w-full p-2 border rounded" value={formData.arrival_time} onChange={e => setFormData({...formData, arrival_time: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Departure Time</label><input type="datetime-local" className="w-full p-2 border rounded" value={formData.departure_time} onChange={e => setFormData({...formData, departure_time: e.target.value})} /></div>
            </div>
          </fieldset>

          <fieldset className="border rounded-lg p-4">
            <legend className="font-bold text-lg px-2">Transfer Details</legend>
            <div className="grid md:grid-cols-2 gap-4 mt-2">
              <div><label className="block font-bold mb-1">Transfer Type *</label>
                <select className="w-full p-2 border rounded" value={formData.transfer_type} onChange={e => setFormData({...formData, transfer_type: e.target.value})}>
                  <option value="pickup">From Airport to Destination</option>
                  <option value="dropoff">From Pickup to Airport</option>
                </select>
              </div>
              <div><label className="block font-bold mb-1">Pickup Location *</label><input type="text" required className="w-full p-2 border rounded" value={formData.pickup_location} onChange={e => setFormData({...formData, pickup_location: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Drop-off Location *</label><input type="text" required className="w-full p-2 border rounded" value={formData.dropoff_location} onChange={e => setFormData({...formData, dropoff_location: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Pickup Date *</label><input type="date" required className="w-full p-2 border rounded" value={formData.pickup_date} onChange={e => setFormData({...formData, pickup_date: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Pickup Time</label><input type="time" className="w-full p-2 border rounded" value={formData.pickup_time} onChange={e => setFormData({...formData, pickup_time: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Passengers</label><input type="number" min="1" className="w-full p-2 border rounded" value={formData.passengers} onChange={e => setFormData({...formData, passengers: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Luggage Count</label><input type="number" min="0" className="w-full p-2 border rounded" value={formData.luggage_count} onChange={e => setFormData({...formData, luggage_count: e.target.value})} /></div>
            </div>
          </fieldset>

          <fieldset className="border rounded-lg p-4">
            <legend className="font-bold text-lg px-2">Vehicle Preference</legend>
            <div className="grid md:grid-cols-2 gap-4 mt-2">
              <div><label className="block font-bold mb-1">Vehicle Type</label><input type="text" className="w-full p-2 border rounded" value={formData.vehicle_type} onChange={e => setFormData({...formData, vehicle_type: e.target.value})} placeholder="e.g., Sedan, SUV, Minibus" /></div>
              <div><label className="block font-bold mb-1">Special Requests</label><input type="text" className="w-full p-2 border rounded" value={formData.special_requests} onChange={e => setFormData({...formData, special_requests: e.target.value})} placeholder="e.g., wheelchair accessible" /></div>
            </div>
          </fieldset>

          <div><label className="block font-bold mb-1">Base Amount (ZMW)</label><input type="number" step="0.01" className="w-full p-2 border rounded" value={formData.base_amount} onChange={e => setFormData({...formData, base_amount: e.target.value})} /></div>
          <div><label className="block font-bold mb-1">Notes</label><textarea className="w-full p-2 border rounded" rows="3" value={formData.notes} onChange={e => setFormData({...formData, notes: e.target.value})} /></div>

          <button type="submit" disabled={loading} className="btn-primary w-full">{loading ? 'Submitting...' : 'Submit Request'}</button>
        </form>
      </div>
    </div>
  );
};

export default AirportTransferRequest;








import { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import api from '../services/api';
import toast from 'react-hot-toast';

const CarHireRequest = () => {
  const navigate = useNavigate();
  const [loading, setLoading] = useState(false);
  const [files, setFiles] = useState({ license: null, passport: null });

  const [formData, setFormData] = useState({
    action_type: 'quote',
    full_name: '',
    phone: '',
    email: '',
    driver_license_number: '',
    driver_license_expiry: '',
    nationality: '',
    date_of_birth: '',
    pickup_location: '',
    dropoff_location: '',
    pickup_date: '',
    pickup_time: '',
    dropoff_date: '',
    dropoff_time: '',
    rental_duration_days: '',
    vehicle_type: '',
    preferred_model: '',
    transmission: '',
    fuel_policy: 'Full-to-Full',
    additional_drivers: 0,
    child_seat: false,
    gps_navigation: false,
    base_amount: 0,
    notes: ''
  });

  const handleFileChange = (e, type) => {
    const file = e.target.files[0];
    if (file) setFiles(prev => ({ ...prev, [type]: file }));
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    setLoading(true);

    const payload = {
      ...formData,
      service_type: 'carhire',
      email: formData.email || null,
      driver_license_expiry: new Date(formData.driver_license_expiry).toISOString(),
      date_of_birth: formData.date_of_birth ? new Date(formData.date_of_birth).toISOString() : null,
      pickup_date: new Date(formData.pickup_date).toISOString(),
      dropoff_date: formData.dropoff_date ? new Date(formData.dropoff_date).toISOString() : null,
      base_amount: parseFloat(formData.base_amount) || 0,
      notes: formData.notes || null,
    };

    try {
      const formDataObj = new FormData();
      formDataObj.append('data', JSON.stringify(payload));
      if (files.license) formDataObj.append('license_file', files.license);
      if (files.passport) formDataObj.append('passport_file', files.passport);

      const res = await api.post('/api/carhire/request', formDataObj, {
        headers: { 'Content-Type': 'multipart/form-data' }
      });
      toast.success('Car hire request submitted!');
      navigate('/dashboard');
    } catch (err) {
      toast.error('Failed to submit');
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="container mx-auto px-4 py-12 max-w-4xl">
      <div className="glass-card p-8">
        <h1 className="text-3xl font-black mb-6">Car Hire / Rental Request</h1>
        <form onSubmit={handleSubmit} className="space-y-8">
          <fieldset className="border rounded-lg p-4">
            <legend className="font-bold text-lg px-2">Personal Details</legend>
            <div className="grid md:grid-cols-2 gap-4 mt-2">
              <div><label className="block font-bold mb-1">Full Name *</label><input type="text" required className="w-full p-2 border rounded" value={formData.full_name} onChange={e => setFormData({...formData, full_name: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Phone *</label><input type="tel" required className="w-full p-2 border rounded" value={formData.phone} onChange={e => setFormData({...formData, phone: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Email *</label><input type="email" required className="w-full p-2 border rounded" value={formData.email} onChange={e => setFormData({...formData, email: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Nationality</label><input type="text" className="w-full p-2 border rounded" value={formData.nationality} onChange={e => setFormData({...formData, nationality: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Date of Birth</label><input type="date" className="w-full p-2 border rounded" value={formData.date_of_birth} onChange={e => setFormData({...formData, date_of_birth: e.target.value})} /></div>
            </div>
          </fieldset>

          <fieldset className="border rounded-lg p-4">
            <legend className="font-bold text-lg px-2">Driver License</legend>
            <div className="grid md:grid-cols-2 gap-4 mt-2">
              <div><label className="block font-bold mb-1">License Number *</label><input type="text" required className="w-full p-2 border rounded" value={formData.driver_license_number} onChange={e => setFormData({...formData, driver_license_number: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Expiry Date *</label><input type="date" required className="w-full p-2 border rounded" value={formData.driver_license_expiry} onChange={e => setFormData({...formData, driver_license_expiry: e.target.value})} /></div>
            </div>
          </fieldset>

          <fieldset className="border rounded-lg p-4">
            <legend className="font-bold text-lg px-2">Rental Details</legend>
            <div className="grid md:grid-cols-2 gap-4 mt-2">
              <div><label className="block font-bold mb-1">Pickup Location *</label><input type="text" required className="w-full p-2 border rounded" value={formData.pickup_location} onChange={e => setFormData({...formData, pickup_location: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Drop-off Location</label><input type="text" className="w-full p-2 border rounded" value={formData.dropoff_location} onChange={e => setFormData({...formData, dropoff_location: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Pickup Date *</label><input type="date" required className="w-full p-2 border rounded" value={formData.pickup_date} onChange={e => setFormData({...formData, pickup_date: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Pickup Time</label><input type="time" className="w-full p-2 border rounded" value={formData.pickup_time} onChange={e => setFormData({...formData, pickup_time: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Drop-off Date</label><input type="date" className="w-full p-2 border rounded" value={formData.dropoff_date} onChange={e => setFormData({...formData, dropoff_date: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Drop-off Time</label><input type="time" className="w-full p-2 border rounded" value={formData.dropoff_time} onChange={e => setFormData({...formData, dropoff_time: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Rental Duration (days)</label><input type="number" min="1" className="w-full p-2 border rounded" value={formData.rental_duration_days} onChange={e => setFormData({...formData, rental_duration_days: e.target.value})} /></div>
            </div>
          </fieldset>

          <fieldset className="border rounded-lg p-4">
            <legend className="font-bold text-lg px-2">Vehicle Preferences</legend>
            <div className="grid md:grid-cols-2 gap-4 mt-2">
              <div><label className="block font-bold mb-1">Vehicle Type</label><input type="text" className="w-full p-2 border rounded" value={formData.vehicle_type} onChange={e => setFormData({...formData, vehicle_type: e.target.value})} placeholder="e.g., SUV, Sedan" /></div>
              <div><label className="block font-bold mb-1">Preferred Model</label><input type="text" className="w-full p-2 border rounded" value={formData.preferred_model} onChange={e => setFormData({...formData, preferred_model: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Transmission</label>
                <select className="w-full p-2 border rounded" value={formData.transmission} onChange={e => setFormData({...formData, transmission: e.target.value})}>
                  <option value="">Any</option>
                  <option value="Automatic">Automatic</option>
                  <option value="Manual">Manual</option>
                </select>
              </div>
              <div><label className="block font-bold mb-1">Fuel Policy</label>
                <select className="w-full p-2 border rounded" value={formData.fuel_policy} onChange={e => setFormData({...formData, fuel_policy: e.target.value})}>
                  <option value="Full-to-Full">Full-to-Full</option>
                  <option value="Pre-paid">Pre-paid</option>
                </select>
              </div>
              <div><label className="block font-bold mb-1">Additional Drivers</label><input type="number" min="0" className="w-full p-2 border rounded" value={formData.additional_drivers} onChange={e => setFormData({...formData, additional_drivers: parseInt(e.target.value) || 0})} /></div>
              <div className="flex items-center gap-4"><label><input type="checkbox" checked={formData.child_seat} onChange={e => setFormData({...formData, child_seat: e.target.checked})} /> Child Seat</label><label><input type="checkbox" checked={formData.gps_navigation} onChange={e => setFormData({...formData, gps_navigation: e.target.checked})} /> GPS Navigation</label></div>
            </div>
          </fieldset>

          <fieldset className="border rounded-lg p-4">
            <legend className="font-bold text-lg px-2">Upload Documents</legend>
            <div className="grid md:grid-cols-2 gap-4 mt-2">
              <div><label className="block font-bold mb-1">Driver License Copy</label><input type="file" accept="image/*,application/pdf" onChange={(e) => handleFileChange(e, 'license')} className="w-full p-2 border rounded" /></div>
              <div><label className="block font-bold mb-1">Passport Copy</label><input type="file" accept="image/*,application/pdf" onChange={(e) => handleFileChange(e, 'passport')} className="w-full p-2 border rounded" /></div>
            </div>
          </fieldset>

          <div><label className="block font-bold mb-1">Base Amount (ZMW)</label><input type="number" step="0.01" className="w-full p-2 border rounded" value={formData.base_amount} onChange={e => setFormData({...formData, base_amount: e.target.value})} /></div>
          <div><label className="block font-bold mb-1">Notes</label><textarea className="w-full p-2 border rounded" rows="3" value={formData.notes} onChange={e => setFormData({...formData, notes: e.target.value})} /></div>

          <button type="submit" disabled={loading} className="btn-primary w-full">{loading ? 'Submitting...' : 'Submit Request'}</button>
        </form>
      </div>
    </div>
  );
};

export default CarHireRequest;


import { useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import api from '../services/api';
import toast from 'react-hot-toast';
import PriceCalculator from '../components/PriceCalculator';

const FlightRequest = () => {
  const navigate = useNavigate();
  const [airlines, setAirlines] = useState([]);
  const [loading, setLoading] = useState(false);
  const [priceAvailable, setPriceAvailable] = useState(null);
  const [calculatedPrice, setCalculatedPrice] = useState(null);
  const [files, setFiles] = useState({ passport: null, visa: null });

  const [formData, setFormData] = useState({
    action_type: 'quote',
    // Personal details
    full_name: '',
    passport_number: '',
    passport_expiry: '',
    nationality: '',
    date_of_birth: '',
    gender: 'male',
    // Contact
    phone: '',
    email: '',
    address: '',
    // Flight details
    airline_id: '',
    origin: '',
    destination: '',
    travel_date: '',
    return_date: '',
    travel_class: 'economy',
    passengers: 1,
    // Additional services
    meal_preference: 'standard',
    seat_preference: 'window',
    special_assistance: '',
    // Internal
    notes: '',
    base_amount: 0
  });

  // Fetch airlines on mount
  useEffect(() => {
    api.get('/api/pricing/airlines')
      .then(res => setAirlines(res.data))
      .catch(err => console.error('Failed to load airlines', err));
  }, []);

  const handlePriceFetched = (amount) => {
    setCalculatedPrice(amount);
    setPriceAvailable(amount !== null);
    if (amount !== null) {
      setFormData(prev => ({ ...prev, base_amount: amount }));
    }
  };

  const handleFileChange = (e, type) => {
    const file = e.target.files[0];
    if (file) {
      setFiles(prev => ({ ...prev, [type]: file }));
    }
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    setLoading(true);

    // Build payload
    const payload = {
      ...formData,
      service_type: 'flight_ticketing',
      email: formData.email || null,
      travel_date: formData.travel_date ? new Date(formData.travel_date).toISOString() : null,
      return_date: formData.return_date ? new Date(formData.return_date).toISOString() : null,
      passengers: parseInt(formData.passengers, 10),
      base_amount: calculatedPrice || parseFloat(formData.base_amount) || 0,
      notes: formData.notes || null,
      // Pass extra fields as JSON in a separate field (service_data)
      service_data: {
        passport_number: formData.passport_number,
        passport_expiry: formData.passport_expiry,
        nationality: formData.nationality,
        date_of_birth: formData.date_of_birth,
        gender: formData.gender,
        address: formData.address,
        meal_preference: formData.meal_preference,
        seat_preference: formData.seat_preference,
        special_assistance: formData.special_assistance,
      }
    };

    try {
      // Submit as multipart/form-data if we have files
      if (files.passport || files.visa) {
        const formDataObj = new FormData();
        // Append all fields as JSON
        formDataObj.append('data', JSON.stringify(payload));
        if (files.passport) formDataObj.append('passport', files.passport);
        if (files.visa) formDataObj.append('visa', files.visa);
        const res = await api.post('/api/flight/request', formDataObj, {
          headers: { 'Content-Type': 'multipart/form-data' }
        });
        toast.success('Flight request submitted!');
        if (priceAvailable && formData.action_type !== 'quote') {
          navigate(`/payment/flight/${res.data.id}`);
        } else {
          navigate('/dashboard');
        }
      } else {
        const res = await api.post('/api/flight/request', payload);
        toast.success('Flight request submitted!');
        if (priceAvailable && formData.action_type !== 'quote') {
          navigate(`/payment/flight/${res.data.id}`);
        } else {
          navigate('/dashboard');
        }
      }
    } catch (err) {
      const detail = err.response?.data?.detail;
      if (Array.isArray(detail)) toast.error(detail.map(e => e.msg).join(', '));
      else if (typeof detail === 'string') toast.error(detail);
      else toast.error('Failed to submit');
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="container mx-auto px-4 py-12 max-w-4xl">
      <div className="glass-card p-8">
        <h1 className="text-3xl font-black mb-6">Flight Booking Request</h1>
        <form onSubmit={handleSubmit} className="space-y-8">
          {/* Personal Information */}
          <fieldset className="border rounded-lg p-4">
            <legend className="font-bold text-lg px-2">Passenger Details</legend>
            <div className="grid md:grid-cols-2 gap-4 mt-2">
              <div><label className="block font-bold mb-1">Full Name (as per passport) *</label><input type="text" required className="w-full p-2 border rounded" value={formData.full_name} onChange={e => setFormData({...formData, full_name: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Passport Number *</label><input type="text" required className="w-full p-2 border rounded" value={formData.passport_number} onChange={e => setFormData({...formData, passport_number: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Passport Expiry Date *</label><input type="date" required className="w-full p-2 border rounded" value={formData.passport_expiry} onChange={e => setFormData({...formData, passport_expiry: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Nationality *</label><input type="text" required className="w-full p-2 border rounded" value={formData.nationality} onChange={e => setFormData({...formData, nationality: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Date of Birth *</label><input type="date" required className="w-full p-2 border rounded" value={formData.date_of_birth} onChange={e => setFormData({...formData, date_of_birth: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Gender *</label><select className="w-full p-2 border rounded" value={formData.gender} onChange={e => setFormData({...formData, gender: e.target.value})}><option value="male">Male</option><option value="female">Female</option><option value="other">Other</option></select></div>
            </div>
          </fieldset>

          {/* Contact Details */}
          <fieldset className="border rounded-lg p-4">
            <legend className="font-bold text-lg px-2">Contact Information</legend>
            <div className="grid md:grid-cols-2 gap-4 mt-2">
              <div><label className="block font-bold mb-1">Phone *</label><input type="tel" required className="w-full p-2 border rounded" value={formData.phone} onChange={e => setFormData({...formData, phone: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Email *</label><input type="email" required className="w-full p-2 border rounded" value={formData.email} onChange={e => setFormData({...formData, email: e.target.value})} /></div>
              <div className="md:col-span-2"><label className="block font-bold mb-1">Address</label><input type="text" className="w-full p-2 border rounded" value={formData.address} onChange={e => setFormData({...formData, address: e.target.value})} /></div>
            </div>
          </fieldset>

          {/* Flight Details */}
          <fieldset className="border rounded-lg p-4">
            <legend className="font-bold text-lg px-2">Flight Details</legend>
            <div className="grid md:grid-cols-2 gap-4 mt-2">
              <div><label className="block font-bold mb-1">Airline *</label>
                <select className="w-full p-2 border rounded" value={formData.airline_id} onChange={e => setFormData({...formData, airline_id: e.target.value})}>
                  <option value="">Select Airline</option>
                  {airlines.map(a => <option key={a.id} value={a.id}>{a.name}</option>)}
                </select>
              </div>
              <div><label className="block font-bold mb-1">Travel Class *</label>
                <select className="w-full p-2 border rounded" value={formData.travel_class} onChange={e => setFormData({...formData, travel_class: e.target.value})}>
                  <option value="economy">Economy</option>
                  <option value="business">Business</option>
                  <option value="first">First</option>
                </select>
              </div>
              <div><label className="block font-bold mb-1">Origin (Airport/City) *</label><input type="text" required className="w-full p-2 border rounded" value={formData.origin} onChange={e => setFormData({...formData, origin: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Destination *</label><input type="text" required className="w-full p-2 border rounded" value={formData.destination} onChange={e => setFormData({...formData, destination: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Outbound Date *</label><input type="date" required className="w-full p-2 border rounded" value={formData.travel_date} onChange={e => setFormData({...formData, travel_date: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Return Date</label><input type="date" className="w-full p-2 border rounded" value={formData.return_date} onChange={e => setFormData({...formData, return_date: e.target.value})} /></div>
              <div><label className="block font-bold mb-1">Passengers *</label><input type="number" min="1" required className="w-full p-2 border rounded" value={formData.passengers} onChange={e => setFormData({...formData, passengers: e.target.value})} /></div>
            </div>
          </fieldset>

          {/* Additional Services */}
          <fieldset className="border rounded-lg p-4">
            <legend className="font-bold text-lg px-2">Additional Options</legend>
            <div className="grid md:grid-cols-2 gap-4 mt-2">
              <div><label className="block font-bold mb-1">Meal Preference</label>
                <select className="w-full p-2 border rounded" value={formData.meal_preference} onChange={e => setFormData({...formData, meal_preference: e.target.value})}>
                  <option value="standard">Standard</option>
                  <option value="vegetarian">Vegetarian</option>
                  <option value="vegan">Vegan</option>
                  <option value="halal">Halal</option>
                  <option value="kosher">Kosher</option>
                  <option value="diabetic">Diabetic</option>
                </select>
              </div>
              <div><label className="block font-bold mb-1">Seat Preference</label>
                <select className="w-full p-2 border rounded" value={formData.seat_preference} onChange={e => setFormData({...formData, seat_preference: e.target.value})}>
                  <option value="window">Window</option>
                  <option value="aisle">Aisle</option>
                  <option value="middle">Middle</option>
                  <option value="no_preference">No Preference</option>
                </select>
              </div>
              <div className="md:col-span-2"><label className="block font-bold mb-1">Special Assistance</label><input type="text" className="w-full p-2 border rounded" value={formData.special_assistance} onChange={e => setFormData({...formData, special_assistance: e.target.value})} placeholder="E.g., wheelchair, visual assistance, etc." /></div>
            </div>
          </fieldset>

          {/* Price Calculator */}
          <PriceCalculator
            serviceType="flight"
            params={{
              airline_id: formData.airline_id,
              origin: formData.origin,
              destination: formData.destination,
              travel_class: formData.travel_class
            }}
            onPriceFetched={handlePriceFetched}
          />

          {/* File Uploads */}
          <fieldset className="border rounded-lg p-4">
            <legend className="font-bold text-lg px-2">Document Upload</legend>
            <div className="grid md:grid-cols-2 gap-4 mt-2">
              <div><label className="block font-bold mb-1">Passport Copy (PDF/Image)</label><input type="file" accept="image/*,application/pdf" onChange={(e) => handleFileChange(e, 'passport')} className="w-full p-2 border rounded" /></div>
              <div><label className="block font-bold mb-1">Visa Copy (if applicable)</label><input type="file" accept="image/*,application/pdf" onChange={(e) => handleFileChange(e, 'visa')} className="w-full p-2 border rounded" /></div>
            </div>
          </fieldset>

          {/* Internal Notes */}
          <div><label className="block font-bold mb-1">Internal Notes (for company use)</label><textarea className="w-full p-2 border rounded" rows="3" value={formData.notes} onChange={e => setFormData({...formData, notes: e.target.value})} placeholder="Any internal remarks or special instructions" /></div>

          <button type="submit" disabled={loading} className="btn-primary w-full">
            {loading ? 'Submitting...' : (priceAvailable && formData.action_type !== 'quote' ? 'Proceed to Payment' : 'Request Quotation')}
          </button>
        </form>
      </div>
    </div>
  );
};

export default FlightRequest;


import { useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import api from '../services/api';
import toast from 'react-hot-toast';
import PriceCalculator from '../components/PriceCalculator';

const InsuranceRequest = () => {
  const navigate = useNavigate();
  const [formData, setFormData] = useState({
    buyer_name: '',
    phone: '',
    email: '',
    vehicle_type: 'Private Car',
    vehicle_make_model: '',
    number_plate: '',
    insurance_type: 'third_party',
    start_date: '',
    quarters: 1,
    base_premium: 0,
    // Insurance price calculator fields
    company_id: '',
    notes: ''
  });
  const [priceAvailable, setPriceAvailable] = useState(null);
  const [calculatedPremium, setCalculatedPremium] = useState(null);

  const handlePriceFetched = (amount, message) => {
    setCalculatedPremium(amount);
    setPriceAvailable(amount !== null);
    if (amount !== null) {
      setFormData(prev => ({ ...prev, base_premium: amount }));
    }
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    const payload = {
      buyer_name: formData.buyer_name,
      phone: formData.phone,
      email: formData.email || null,
      vehicle_type: formData.vehicle_type,
      vehicle_make_model: formData.vehicle_make_model,
      number_plate: formData.number_plate,
      insurance_type: formData.insurance_type,
      start_date: formData.start_date,
      quarters: parseInt(formData.quarters, 10),
      base_premium: calculatedPremium || parseFloat(formData.base_premium) || 0,
      notes: formData.notes || null,
    };

    try {
      const response = await api.post('/api/insurance/request', payload);
      const requestId = response.data.id;
      toast.success('Insurance request submitted!');
      if (priceAvailable) {
        navigate(`/payment/insurance/${requestId}`);
      } else {
        navigate('/dashboard');
      }
    } catch (err) {
      const detail = err.response?.data?.detail;
      if (Array.isArray(detail)) {
        toast.error(detail.map(e => e.msg).join(', '));
      } else if (typeof detail === 'string') {
        toast.error(detail);
      } else {
        toast.error('Failed to submit request. Please check all fields.');
      }
    }
  };

  return (
    <div className="container mx-auto px-4 py-12 max-w-3xl">
      <div className="glass-card p-8">
        <h1 className="text-3xl font-black mb-6">Buy / Renew Vehicle Insurance</h1>
        <form onSubmit={handleSubmit} className="space-y-6">
          <div className="grid md:grid-cols-2 gap-6">
            <div><label className="block font-bold mb-2">Full Name *</label><input type="text" required className="w-full p-3 rounded-xl border" value={formData.buyer_name} onChange={e => setFormData({...formData, buyer_name: e.target.value})}/></div>
            <div><label className="block font-bold mb-2">Phone *</label><input type="tel" required className="w-full p-3 rounded-xl border" value={formData.phone} onChange={e => setFormData({...formData, phone: e.target.value})}/></div>
          </div>
          <div><label className="block font-bold mb-2">Email</label><input type="email" className="w-full p-3 rounded-xl border" value={formData.email} onChange={e => setFormData({...formData, email: e.target.value})}/></div>

          {/* Insurance company selection for price calculation */}
          <div><label className="block font-bold mb-2">Insurance Company</label>
            <select className="w-full p-3 rounded-xl border" value={formData.company_id} onChange={e => setFormData({...formData, company_id: e.target.value})}>
              <option value="">Select Company (for instant price)</option>
              {/* Load companies from backend */}
              <option value="some-id">Madison Insurance</option>
              <option value="some-id2">Professional Insurance</option>
            </select>
          </div>

          <div className="grid md:grid-cols-2 gap-6">
            <div><label className="block font-bold mb-2">Vehicle Type</label><input type="text" className="w-full p-3 rounded-xl border" value={formData.vehicle_type} onChange={e => setFormData({...formData, vehicle_type: e.target.value})}/></div>
            <div><label className="block font-bold mb-2">Make & Model *</label><input type="text" required className="w-full p-3 rounded-xl border" value={formData.vehicle_make_model} onChange={e => setFormData({...formData, vehicle_make_model: e.target.value})}/></div>
          </div>
          <div><label className="block font-bold mb-2">Number Plate *</label><input type="text" required className="w-full p-3 rounded-xl border" value={formData.number_plate} onChange={e => setFormData({...formData, number_plate: e.target.value})}/></div>

          <div className="grid md:grid-cols-2 gap-6">
            <div><label className="block font-bold mb-2">Insurance Type *</label><select className="w-full p-3 rounded-xl border" value={formData.insurance_type} onChange={e => setFormData({...formData, insurance_type: e.target.value})}><option value="third_party">Third Party</option><option value="comprehensive">Comprehensive</option></select></div>
            <div><label className="block font-bold mb-2">Start Date *</label><input type="date" required className="w-full p-3 rounded-xl border" value={formData.start_date} onChange={e => setFormData({...formData, start_date: e.target.value})}/></div>
          </div>
          <div><label className="block font-bold mb-2">Number of Quarters (90 days each)</label><select className="w-full p-3 rounded-xl border" value={formData.quarters} onChange={e => setFormData({...formData, quarters: parseInt(e.target.value)})}><option value="1">1 Quarter (90 days)</option><option value="2">2 Quarters (180 days)</option><option value="3">3 Quarters (270 days)</option><option value="4">4 Quarters (360 days)</option></select></div>

          {/* Price Calculator for Insurance */}
          <PriceCalculator
            serviceType="insurance"
            params={{
              company_id: formData.company_id,
              vehicle_type: formData.vehicle_type,
              insurance_type: formData.insurance_type,
              quarters: formData.quarters
            }}
            onPriceFetched={handlePriceFetched}
          />

          <div><label className="block font-bold mb-2">Notes</label><textarea className="w-full p-3 rounded-xl border" rows="3" value={formData.notes} onChange={e => setFormData({...formData, notes: e.target.value})}/></div>

          <button type="submit" className="btn-primary w-full justify-center">
            {priceAvailable ? 'Proceed to Payment' : 'Request Quotation'}
          </button>
        </form>
      </div>
    </div>
  );
};

export default InsuranceRequest;


import { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import api from '../services/api';
import toast from 'react-hot-toast';

const VisaRequest = () => {
  const navigate = useNavigate();
  const [formData, setFormData] = useState({
    applicant_name: '',
    phone: '',
    email: '',
    destination_country: '',
    visa_type: 'tourist',
    passport_number: '',
    travel_date: '',
    base_fee: 0,
    notes: ''
  });
  const [priceAvailable, setPriceAvailable] = useState(false); // for visa, usually need quotation

  const handleSubmit = async (e) => {
    e.preventDefault();
    const payload = {
      ...formData,
      email: formData.email || null,
      travel_date: formData.travel_date ? new Date(formData.travel_date).toISOString() : null,
      base_fee: parseFloat(formData.base_fee) || 0,
      notes: formData.notes || null,
    };
    try {
      const response = await api.post('/api/visa/request', payload);
      const requestId = response.data.id;
      toast.success('Visa assistance request submitted!');
      if (priceAvailable) {
        navigate(`/payment/visa/${requestId}`);
      } else {
        navigate('/dashboard');
      }
    } catch (err) {
      toast.error('Failed to submit request');
    }
  };

  return (
    <div className="container mx-auto px-4 py-12 max-w-3xl">
      <div className="glass-card p-8">
        <h1 className="text-3xl font-black mb-6">Visa Assistance Request</h1>
        <form onSubmit={handleSubmit} className="space-y-6">
          <div className="grid md:grid-cols-2 gap-6">
            <div><label className="block font-bold mb-2">Full Name *</label><input type="text" required className="w-full p-3 rounded-xl border" value={formData.applicant_name} onChange={e => setFormData({...formData, applicant_name: e.target.value})}/></div>
            <div><label className="block font-bold mb-2">Phone *</label><input type="tel" required className="w-full p-3 rounded-xl border" value={formData.phone} onChange={e => setFormData({...formData, phone: e.target.value})}/></div>
          </div>
          <div><label className="block font-bold mb-2">Email</label><input type="email" className="w-full p-3 rounded-xl border" value={formData.email} onChange={e => setFormData({...formData, email: e.target.value})}/></div>
          <div className="grid md:grid-cols-2 gap-6">
            <div><label className="block font-bold mb-2">Destination Country *</label><input type="text" required className="w-full p-3 rounded-xl border" value={formData.destination_country} onChange={e => setFormData({...formData, destination_country: e.target.value})}/></div>
            <div><label className="block font-bold mb-2">Visa Type *</label><select required className="w-full p-3 rounded-xl border" value={formData.visa_type} onChange={e => setFormData({...formData, visa_type: e.target.value})}><option value="tourist">Tourist</option><option value="business">Business</option><option value="student">Student</option><option value="transit">Transit</option><option value="work">Work</option></select></div>
          </div>
          <div><label className="block font-bold mb-2">Passport Number *</label><input type="text" required className="w-full p-3 rounded-xl border" value={formData.passport_number} onChange={e => setFormData({...formData, passport_number: e.target.value})}/></div>
          <div><label className="block font-bold mb-2">Intended Travel Date</label><input type="date" className="w-full p-3 rounded-xl border" value={formData.travel_date} onChange={e => setFormData({...formData, travel_date: e.target.value})}/></div>
          <div><label className="block font-bold mb-2">Visa Fee (Embassy/Consulate) - ZMW</label><input type="number" min="0" step="0.01" className="w-full p-3 rounded-xl border" value={formData.base_fee} onChange={e => setFormData({...formData, base_fee: e.target.value})}/></div>
          <div><label className="block font-bold mb-2">Notes</label><textarea className="w-full p-3 rounded-xl border" rows="3" value={formData.notes} onChange={e => setFormData({...formData, notes: e.target.value})}/></div>
          <button type="submit" className="btn-primary w-full justify-center">
            Request Quotation
          </button>
        </form>
      </div>
    </div>
  );
};

export default VisaRequest;